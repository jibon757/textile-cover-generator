{
  // Cloudflare Worker settings. One Worker serves the website AND the /api backend.
  "name": "textile-cover-generator",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // Build the website first (creates the dist folder), then deploy.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare Browser Run: turns pages into real A4 PDFs (free: 10 minutes/day).
  "browser": {
    "binding": "BROWSER"
  },
  // Cloudflare Workers AI: makes the subject pictures (free: 10,000 neurons/day).
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "APP_VERSION": "0.7.3",
    "FIREBASE_PROJECT_ID": "textile-cover-generator",
    "CLOUDINARY_CLOUD_NAME": "hh9hmbra"
  }
}
